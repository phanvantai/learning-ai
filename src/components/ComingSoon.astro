---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
  summary: string;
}

const { title, summary } = Astro.props;
---

<BaseLayout title={title}>
  <section class="page-header">
    <h1>{title}</h1>
    <p class="badge">Sắp ra mắt</p>
    <p class="lead">{summary}</p>
    <p><a href="/">← Về Trang chủ</a></p>
  </section>
</BaseLayout>
