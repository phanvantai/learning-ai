---
import { baiChiaSeHref, type BaiChiaSe } from '../bai-chia-se';
import ChuDeTags from './ChuDeTags.astro';
import PublishedDate from './PublishedDate.astro';

interface Props {
  bai: BaiChiaSe;
  /** Cấp tiêu đề của bài, theo cấu trúc trang chứa thẻ này. */
  headingLevel?: 'h2' | 'h3';
}

const { bai, headingLevel: Heading = 'h2' } = Astro.props;
---

<article class="bai-chia-se-card">
  <p class="date"><PublishedDate date={bai.data.date} /></p>
  <Heading class="title"><a href={baiChiaSeHref(bai)}>{bai.data.title}</a></Heading>
  <p class="description">{bai.data.description}</p>
  <ChuDeTags bai={bai} />
</article>

<style>
  .bai-chia-se-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-top: 4px solid var(--accent-glow);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition:
      transform 200ms var(--ease),
      box-shadow 200ms var(--ease);
  }

  .bai-chia-se-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .date {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .title {
    margin: 0.4rem 0 0.6rem;
    font-size: 1.2rem;
    line-height: 1.35;
  }

  /* Cả thẻ bấm được nhờ vệt phủ của link tiêu đề; link thẻ chủ đề nằm trên vệt phủ. */
  .title a {
    color: var(--text);
    text-decoration: none;
  }

  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .bai-chia-se-card:hover .title a {
    color: var(--accent);
  }

  .description {
    flex: 1;
    margin: 0 0 1.1rem;
    color: var(--muted);
    font-size: 0.975rem;
  }

  .bai-chia-se-card :global(.chu-de-tags) {
    position: relative;
    z-index: 1;
  }
</style>
