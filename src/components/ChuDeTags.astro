---
import type { BaiChiaSe } from '../bai-chia-se';
import { chuDeHref, taoChuDe } from '../chu-de';

interface Props {
  bai: BaiChiaSe;
}

const { bai } = Astro.props;
// Giữ thứ tự thẻ như người viết ghi trong frontmatter.
const chuDe = bai.data.tags.map(taoChuDe);
---

<ul class="chu-de-tags" aria-label="Thẻ chủ đề">
  {
    chuDe.map((muc) => (
      <li>
        <a href={chuDeHref(muc)}>{muc.ten}</a>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.9rem;
    list-style: none;
  }

  a {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }

  a::before {
    content: '#';
  }

  a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
</style>
