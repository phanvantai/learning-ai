---
import type { BaiChiaSe } from '../bai-chia-se';
import { chuDeHref, taoChuDe } from '../chu-de';

interface Props {
  bai: BaiChiaSe;
}

const { bai } = Astro.props;
// Giữ thứ tự thẻ như người viết ghi trong frontmatter.
const chuDe = bai.data.tags.map(taoChuDe);
---

<ul class="chu-de-tags" aria-label="Thẻ chủ đề">
  {
    chuDe.map((muc) => (
      <li>
        <a href={chuDeHref(muc)}>{muc.ten}</a>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--teal-soft);
    color: var(--teal);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    transition: box-shadow 150ms var(--ease);
  }

  a:hover {
    color: var(--teal);
    box-shadow: inset 0 0 0 1.5px var(--teal);
  }
</style>
