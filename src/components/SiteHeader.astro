---
import { NAV_ITEMS, SITE } from '../site';
import Icon from './Icon.astro';

const currentPath = Astro.url.pathname;

/** `page` cho đúng trang đang xem; `true` khi đang ở trang con của mục đó (vd. một Bài chia sẻ). */
function ariaCurrent(href: string): 'page' | 'true' | undefined {
  if (href === currentPath) return 'page';
  if (href !== '/' && currentPath.startsWith(href)) return 'true';
  return undefined;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-mark"><Icon name="sparkles" /></span>
      {SITE.name}
    </a>
    <nav aria-label="Điều hướng chính">
      <ul class="nav-list">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} aria-current={ariaCurrent(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
