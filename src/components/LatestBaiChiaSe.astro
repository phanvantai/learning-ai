---
import { DANH_SACH_HREF, getTatCaBaiChiaSe } from '../bai-chia-se';
import BaiChiaSeList from './BaiChiaSeList.astro';
import Icon from './Icon.astro';

/** Số Bài chia sẻ mới nhất hiện trên Trang chủ. */
const SO_BAI = 3;

const moiNhat = (await getTatCaBaiChiaSe()).slice(0, SO_BAI);
---

<section class="container section" aria-labelledby="latest-bai-chia-se">
  <div class="section-head">
    <div>
      <h2 id="latest-bai-chia-se">Bài chia sẻ mới nhất</h2>
      <p>Mỗi tuần 2 bài, viết cho người không làm kỹ thuật.</p>
    </div>
    <a class="arrow-link" href={DANH_SACH_HREF}>Xem tất cả Bài chia sẻ <Icon name="arrow-right" /></a>
  </div>
  <BaiChiaSeList tatCaBai={moiNhat} headingLevel="h3" />
</section>
