---
import type { BaiChiaSe } from '../bai-chia-se';
import BaiChiaSeCard from './BaiChiaSeCard.astro';

interface Props {
  tatCaBai: BaiChiaSe[];
  headingLevel?: 'h2' | 'h3' | 'h4';
  hienLoai?: boolean;
  gon?: boolean;
}

const { tatCaBai, headingLevel, hienLoai, gon } = Astro.props;
---

{
  tatCaBai.length > 0 ? (
    <div class="bai-chia-se-list">
      {tatCaBai.map((bai) => (
        <BaiChiaSeCard bai={bai} headingLevel={headingLevel} hienLoai={hienLoai} gon={gon} />
      ))}
    </div>
  ) : (
    <p class="empty-state">Chưa có Bài chia sẻ nào. Bài đầu tiên sắp lên!</p>
  )
}

<style>
  .bai-chia-se-list {
    border-top: 1px solid var(--ink);
  }
</style>
