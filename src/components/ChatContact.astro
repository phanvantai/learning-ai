---
import { CHAT_CHANNELS } from '../site';
import Icon from './Icon.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section id="lien-he" class="chat-contact" aria-labelledby="chat-contact-title">
  <div class="chat-contact-copy">
    <span class="chat-contact-icon"><Icon name="message" /></span>
    <h2 id="chat-contact-title">{title}</h2>
    <slot />
  </div>
  <ul class="chat-buttons" aria-label="Kênh Tư vấn qua chat">
    {
      CHAT_CHANNELS.map(({ name, href }) => (
        <li>
          {href ? (
            <a class="chat-button" href={href} target="_blank" rel="noopener noreferrer">
              {name}
              <Icon name="arrow-right" />
            </a>
          ) : (
            <span class="chat-button chat-button-pending" aria-disabled="true">
              {name} <small>(sắp có)</small>
            </span>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .chat-contact {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem 3rem;
    align-items: center;
    margin-top: 4.5rem;
    padding: clamp(1.75rem, 5vw, 3rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(30rem 16rem at 100% 0%, rgb(249 115 22 / 0.35), transparent 70%),
      radial-gradient(24rem 14rem at 0% 100%, rgb(45 212 191 / 0.18), transparent 70%),
      var(--ink);
    color: var(--ink-text);
    box-shadow: var(--shadow-lg);
  }

  .chat-contact-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1rem;
    border-radius: 14px;
    background: linear-gradient(135deg, #f97316, #c2410c);
    color: #ffffff;
  }

  .chat-contact-icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .chat-contact h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }

  .chat-contact-copy :global(p) {
    margin: 0;
    color: var(--ink-muted);
  }

  .chat-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chat-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0.75rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.08);
    color: var(--ink-text);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 180ms var(--ease),
      border-color 180ms var(--ease),
      transform 180ms var(--ease);
  }

  a.chat-button:hover {
    border-color: #fb923c;
    background: rgb(249 115 22 / 0.2);
    color: var(--ink-text);
    transform: translateY(-2px);
  }

  .chat-button :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .chat-button-pending {
    border-style: dashed;
    background: transparent;
    color: var(--ink-muted);
    cursor: not-allowed;
  }

  .chat-button-pending small {
    font-weight: 400;
  }

  @media (max-width: 50rem) {
    .chat-contact {
      grid-template-columns: 1fr;
    }
  }
</style>
