---
import { CHAT_CHANNELS } from '../site';
import Icon from './Icon.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section id="lien-he" class="chat-contact" aria-labelledby="chat-contact-title">
  <div class="chat-contact-copy">
    <p class="label">Tư vấn qua chat · không mất phí · không cần đặt lịch</p>
    <h2 id="chat-contact-title">{title}</h2>
    <slot />
  </div>
  <ul class="chat-buttons" aria-label="Kênh Tư vấn qua chat">
    {
      CHAT_CHANNELS.map(({ name, href }) => (
        <li>
          {href ? (
            <a class="chat-button" href={href} target="_blank" rel="noopener noreferrer">
              {name}
              <Icon name="arrow-right" />
            </a>
          ) : (
            <span class="chat-button chat-button-pending" aria-disabled="true">
              {name} <small>(sắp có)</small>
            </span>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .chat-contact {
    display: grid;
    gap: 1.75rem 3rem;
    margin-top: 4rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 2px solid var(--ink);
  }

  .chat-contact h2 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .chat-contact-copy :global(p:not(.label)) {
    max-width: 34rem;
    color: var(--muted);
  }

  .chat-buttons {
    align-self: end;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .chat-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.8rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
  }

  a.chat-button:hover {
    background: var(--mark);
    color: var(--ink);
  }

  .chat-button :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .chat-button-pending {
    color: var(--muted);
    cursor: not-allowed;
  }

  .chat-button-pending small {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
  }

  @media (min-width: 52rem) {
    .chat-contact {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
