---
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/600.css';
import '@fontsource/be-vietnam-pro/700.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import SiteHeader from '../components/SiteHeader.astro';
import { NAV_ITEMS, SITE } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfbf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1513" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <SiteHeader />
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-about">
            <a class="brand" href="/">Learning <span class="mark">AI</span></a>
            <p class="footer-tagline">
              Kỹ sư phần mềm dùng AI mỗi ngày, học công khai: thử gì kể nấy, kể cả những thứ chưa thành
              công.
            </p>
          </div>
          <nav aria-label="Điều hướng chân trang">
            <h2 class="label">Trên trang này</h2>
            <ul>
              {
                NAV_ITEMS.filter((item) => item.href !== '/').map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div>
            <h2 class="label">Liên hệ</h2>
            <ul>
              <li><a href="/#lien-he">Tư vấn qua chat</a></li>
              <li><a href="/mentoring/">Gói Mentoring</a></li>
              <li><a href="/doanh-nghiep/#lien-he-heading">Doanh nghiệp thí điểm</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-bottom label">© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
