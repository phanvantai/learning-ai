---
import ChatContact from '../components/ChatContact.astro';
import LatestBaiChiaSe from '../components/LatestBaiChiaSe.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">Learning AI</p>
    <h1>Kỹ sư phần mềm dùng AI mỗi ngày, chia sẻ những gì thực sự hiệu quả.</h1>
    <p class="lead">
      Hướng dẫn thực tế để dân văn phòng dùng AI cho công việc hằng ngày, kể cả những thứ đã thử và
      không thành công.
    </p>
    <div class="hero-actions">
      <a class="button" href="/bai-chia-se/">Đọc Bài chia sẻ</a>
      <a class="button button-secondary" href="/gioi-thieu/">Về mình</a>
    </div>
  </section>

  <LatestBaiChiaSe />

  <ChatContact title="Hỏi qua chat, miễn phí">
    <p>
      Tư vấn qua chat: nhắn câu hỏi về dùng AI cho công việc của bạn, mình trả lời và gợi ý hướng đi.
      Không cần đặt lịch.
    </p>
  </ChatContact>
</BaseLayout>
