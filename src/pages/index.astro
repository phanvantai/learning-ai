---
import BaiChiaSeList from '../components/BaiChiaSeList.astro';
import ChatContact from '../components/ChatContact.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DANH_SACH_HREF, LOAI_BAI, baiTheoLoai, getTatCaBaiChiaSe } from '../bai-chia-se';
import { BUOI } from '../mentoring-program';
import { MENTORING_BETA as BETA } from '../site';

/** Số Bài chia sẻ mới nhất của mỗi Loại bài hiện trên Trang chủ. */
const SO_BAI = 3;

const tatCaBai = await getTatCaBaiChiaSe();
const theoLoai = LOAI_BAI.map((loai) => ({ ...loai, bai: baiTheoLoai(tatCaBai, loai.ma) }));
---

<BaseLayout>
  <section class="page-head home-head">
    <div class="container head-grid">
      <div>
        <p class="label">Sổ tay học công khai · {tatCaBai.length} Bài chia sẻ · 2 bài mỗi tuần</p>
        <h1>
          Kỹ sư phần mềm dùng AI mỗi ngày, chia sẻ những gì <span class="mark">thực sự hiệu quả</span>.
        </h1>
        <p class="lead">
          Cách dùng AI cho công việc hằng ngày, viết cho người không làm kỹ thuật, kèm một cuốn sổ tay
          chuyên sâu cho ai muốn hiểu bên dưới nó chạy thế nào. Thử gì kể nấy, kể cả thứ không thành công.
        </p>
        <div class="button-row">
          <a class="button" href={DANH_SACH_HREF}>Đọc Bài chia sẻ <Icon name="arrow-right" /></a>
          <a class="button button-secondary" href="#lien-he">Hỏi qua chat, miễn phí</a>
        </div>
      </div>

      <nav class="muc-luc" aria-label="Trên trang này">
        <p class="label">Trên trang này</p>
        <ol>
          {
            theoLoai.map((loai) => (
              <li>
                <a href={`${DANH_SACH_HREF}#${loai.ma}`}>
                  <strong>{loai.ten}</strong>
                  <span>{loai.moTa}</span>
                  <span class="label">{loai.bai.length} bài</span>
                </a>
              </li>
            ))
          }
          <li>
            <a href="/mentoring/">
              <strong>Mentoring</strong>
              <span>
                {BETA.sessions} buổi có lịch hẹn, cùng build một tool, automation hoặc skill AI chạy được.
              </span>
              <span class="label">Gói beta {BETA.price}</span>
            </a>
          </li>
          <li>
            <a href="/doanh-nghiep/">
              <strong>Doanh nghiệp</strong>
              <span>Khóa đào tạo AI cho đội ngũ, theo 3 Cấp độ.</span>
              <span class="label">Đang nhận thí điểm</span>
            </a>
          </li>
        </ol>
      </nav>
    </div>
  </section>

  <div class="container">
    <section class="sheet sheet-first" aria-labelledby="latest-bai-chia-se">
      <div class="sheet-label">
        <h2 id="latest-bai-chia-se">Bài chia sẻ mới nhất</h2>
        <p>Bài Ứng dụng cho công việc hằng ngày, bài Chuyên sâu cho người làm kỹ thuật.</p>
        <p><a class="arrow-link" href={DANH_SACH_HREF}>Xem tất cả <Icon name="arrow-right" /></a></p>
      </div>
      <div class="sheet-body loai-grid">
        {
          theoLoai.map((loai) => (
            <section aria-labelledby={`home-${loai.ma}`} data-loai={loai.ma}>
              <h3 id={`home-${loai.ma}`}>{loai.ten}</h3>
              <p class="note">{loai.moTa}</p>
              <BaiChiaSeList tatCaBai={loai.bai.slice(0, SO_BAI)} headingLevel="h4" gon />
              {loai.bai.length > SO_BAI && (
                <p class="them">
                  <a href={`${DANH_SACH_HREF}#${loai.ma}`}>Tất cả {loai.bai.length} bài {loai.ten}</a>
                </p>
              )}
            </section>
          ))
        }
      </div>
    </section>

    <section class="sheet" aria-labelledby="home-mentoring">
      <div class="sheet-label">
        <h2 id="home-mentoring">Mentoring</h2>
        <p>
          {BETA.sessions} buổi &times; {BETA.minutes} phút trong {BETA.period} để giải một việc lặp lại
          của bạn bằng một sản phẩm chạy được.
        </p>
        <p><a class="arrow-link" href="/mentoring/">Xem chương trình <Icon name="arrow-right" /></a></p>
      </div>
      <div class="sheet-body">
        <ol class="buoi-strip">
          {
            BUOI.map((buoi) => (
              <li>
                <p class="label">Buổi {buoi.so} · {buoi.tuan}</p>
                <h3>{buoi.ten}</h3>
                <p class="note">{buoi.sanPham}</p>
              </li>
            ))
          }
        </ol>
        <p class="note">
          Gói beta {BETA.price}, giới hạn {BETA.slots} suất. Bắt đầu bằng Tư vấn qua chat, chưa cần trả gì.
        </p>
      </div>
    </section>

    <ChatContact title="Hỏi qua chat, miễn phí">
      <p>
        Nhắn câu hỏi về dùng AI cho công việc của bạn, mình trả lời và gợi ý hướng đi. Khi việc cần gọi
        riêng hoặc build cùng, mình sẽ nói rõ đó là Mentoring trước khi bạn trả tiền.
      </p>
    </ChatContact>
  </div>
</BaseLayout>

<style>
  .home-head {
    padding-top: 4.5rem;
  }

  .head-grid {
    display: grid;
    gap: 3rem;
  }

  .home-head h1 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 6.4vw, 4.5rem);
    line-height: 1.1;
  }

  /* Mục lục: như trang đầu của cuốn sổ. */
  .muc-luc {
    align-self: end;
  }

  .muc-luc ol {
    margin-top: 0.6rem;
    list-style: none;
    border-top: 2px solid var(--ink);
    background: var(--paper);
  }

  .muc-luc a {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .muc-luc a:hover strong {
    background: var(--mark);
  }

  .muc-luc strong {
    justify-self: start;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .muc-luc span:not(.label) {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .loai-grid {
    display: grid;
    gap: 2.5rem 3rem;
  }

  .loai-grid > section {
    margin: 0;
  }

  .loai-grid h3 {
    font-size: 1.375rem;
  }

  .loai-grid .note {
    margin: 0.3rem 0 1rem;
  }

  .them {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
  }

  .buoi-strip {
    display: grid;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .buoi-strip li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .buoi-strip h3 {
    margin: 0.3rem 0 0.4rem;
    font-size: 1.1875rem;
  }

  @media (min-width: 44rem) {
    .loai-grid {
      grid-template-columns: 1fr 1fr;
    }

    .buoi-strip {
      grid-template-columns: repeat(4, 1fr);
      border-bottom: 1px solid var(--rule);
    }

    .buoi-strip li {
      padding: 1rem 1rem 1.1rem;
      border-bottom: 0;
      border-left: 1px solid var(--rule);
    }

    .buoi-strip li:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (min-width: 62rem) {
    .head-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
