---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import ChuDeTags from '../../components/ChuDeTags.astro';
import Icon from '../../components/Icon.astro';
import PublishedDate from '../../components/PublishedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DANH_SACH_HREF, getTatCaBaiChiaSe, soPhutDoc } from '../../bai-chia-se';

export const getStaticPaths = (async () => {
  const tatCaBai = await getTatCaBaiChiaSe();
  return tatCaBai.map((bai) => ({ params: { id: bai.id } }));
}) satisfies GetStaticPaths;

/** Trang tự tìm bài theo `id` trên đường dẫn, không nhận props. */
type Props = Record<string, never>;

const bai = await getEntry('baiChiaSe', Astro.params.id);
if (!bai) throw new Error(`Không có Bài chia sẻ "${Astro.params.id}"`);
const { Content } = await render(bai);
const phutDoc = soPhutDoc(bai.body ?? '');
---

<BaseLayout title={bai.data.title} description={bai.data.description}>
  <article class="bai-chia-se">
    <header class="page-hero">
      <div class="container container-narrow">
        <p class="back">
          <a class="arrow-link" href={DANH_SACH_HREF}><Icon name="arrow-left" /> Tất cả Bài chia sẻ</a>
        </p>
        <ChuDeTags bai={bai} />
        <h1>{bai.data.title}</h1>
        <p class="description">{bai.data.description}</p>
        <p class="meta">
          <span><Icon name="calendar" /> <PublishedDate date={bai.data.date} /></span>
          <span><Icon name="clock" /> {phutDoc} phút đọc</span>
        </p>
      </div>
    </header>
    <div class="container container-narrow page-body">
      <div class="prose">
        <Content />
      </div>
      <p class="end">
        <a class="button button-secondary" href={DANH_SACH_HREF}>
          <Icon name="arrow-left" /> Đọc thêm Bài chia sẻ khác
        </a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
  }

  h1 {
    margin: 1rem 0 0.75rem;
    font-size: clamp(1.9rem, 5vw, 2.75rem);
  }

  .description {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
  }

  .end {
    margin: 3rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
