---
import type { GetStaticPaths } from 'astro';
import BaiChiaSeList from '../../../components/BaiChiaSeList.astro';
import ChuDeFilter from '../../../components/ChuDeFilter.astro';
import Icon from '../../../components/Icon.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { DANH_SACH_HREF, getTatCaBaiChiaSe } from '../../../bai-chia-se';
import { baiThuocChuDe, tatCaChuDe } from '../../../chu-de';

export const getStaticPaths = (async () => {
  const chuDe = tatCaChuDe(await getTatCaBaiChiaSe());
  return chuDe.map(({ slug }) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

/** Trang tự tìm thẻ chủ đề theo `slug` trên đường dẫn, không nhận props. */
type Props = Record<string, never>;

const tatCaBai = await getTatCaBaiChiaSe();
const chuDe = tatCaChuDe(tatCaBai);
const dangXem = chuDe.find(({ slug }) => slug === Astro.params.slug);
if (!dangXem) throw new Error(`Không có thẻ chủ đề "${Astro.params.slug}"`);

const baiCoThe = baiThuocChuDe(tatCaBai, dangXem.slug);
const title = `Bài chia sẻ về “${dangXem.ten}”`;
---

<BaseLayout title={title}>
  <section class="page-head">
    <div class="container">
      <p>
        <a class="arrow-link" href={DANH_SACH_HREF}><Icon name="arrow-left" /> Xem tất cả Bài chia sẻ</a>
      </p>
      <h1>{title}</h1>
      <p class="label">{baiCoThe.length} bài có thẻ chủ đề này</p>
    </div>
  </section>

  <div class="container">
    <div class="loc">
      <p class="label">Thẻ chủ đề</p>
      <ChuDeFilter chuDe={chuDe} current={dangXem.slug} />
    </div>
    <BaiChiaSeList tatCaBai={baiCoThe} hienLoai />
  </div>
</BaseLayout>

<style>
  .loc {
    display: grid;
    gap: 0.6rem;
    padding: 1.5rem 0 2rem;
  }
</style>
