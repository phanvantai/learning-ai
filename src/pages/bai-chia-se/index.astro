---
import BaiChiaSeList from '../../components/BaiChiaSeList.astro';
import ChuDeFilter from '../../components/ChuDeFilter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTatCaBaiChiaSe } from '../../bai-chia-se';
import { tatCaChuDe } from '../../chu-de';

const tatCaBai = await getTatCaBaiChiaSe();
---

<BaseLayout title="Bài chia sẻ">
  <section class="page-header">
    <h1>Bài chia sẻ</h1>
    <p class="lead">
      Mỗi tuần 2 bài về cách dùng AI cho công việc hằng ngày: cái gì hiệu quả, và cả những thứ mình đã thử
      mà chưa ổn.
    </p>
  </section>
  <ChuDeFilter chuDe={tatCaChuDe(tatCaBai)} />
  <BaiChiaSeList tatCaBai={tatCaBai} />
</BaseLayout>
