---
import BaiChiaSeList from '../../components/BaiChiaSeList.astro';
import ChuDeFilter from '../../components/ChuDeFilter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LOAI_BAI, baiTheoLoai, getTatCaBaiChiaSe } from '../../bai-chia-se';
import { tatCaChuDe } from '../../chu-de';

const tatCaBai = await getTatCaBaiChiaSe();
// Loại bài chưa có bài nào thì không hiện.
const theoLoai = LOAI_BAI.map((loai) => ({ ...loai, bai: baiTheoLoai(tatCaBai, loai.ma) })).filter(
  (loai) => loai.bai.length > 0,
);
---

<BaseLayout title="Bài chia sẻ">
  <section class="page-head">
    <div class="container">
      <p class="label">{tatCaBai.length} bài · cập nhật 2 bài mỗi tuần</p>
      <h1>Bài chia sẻ</h1>
      <p class="lead">
        Bài Ứng dụng cho công việc hằng ngày. Bài kỹ thuật cho người muốn hiểu bên dưới nằm ở{' '}
        <a href="https://boolery.taiphanvan.dev/ai/">mục AI của Boolery Studio</a>. Cái gì hiệu quả thì kể,
        cái đã thử mà chưa ổn cũng kể.
      </p>
    </div>
  </section>

  <div class="container">
    <div class="loc">
      <p class="label">Thẻ chủ đề</p>
      <ChuDeFilter chuDe={tatCaChuDe(tatCaBai)} />
    </div>

    {
      theoLoai.map((loai) => (
        <section class="sheet" id={loai.ma} aria-labelledby={`${loai.ma}-heading`} data-loai={loai.ma}>
          <div class="sheet-label">
            <p class="label">{loai.bai.length} bài</p>
            <h2 id={`${loai.ma}-heading`}>{loai.ten}</h2>
            <p>{loai.moTa}</p>
          </div>
          <div class="sheet-body">
            <BaiChiaSeList tatCaBai={loai.bai} headingLevel="h3" />
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .loc {
    display: grid;
    gap: 0.6rem;
    padding: 1.5rem 0 0;
  }

  .loc + .sheet {
    margin-top: 1.5rem;
  }

  .sheet-body :global(.bai-chia-se-list) {
    border-top: 0;
    margin-top: -1.25rem;
  }
</style>
