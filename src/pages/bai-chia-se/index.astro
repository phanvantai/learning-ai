---
import BaiChiaSeCard from '../../components/BaiChiaSeCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTatCaBaiChiaSe } from '../../bai-chia-se';

const tatCaBai = await getTatCaBaiChiaSe();
---

<BaseLayout title="Bài chia sẻ">
  <section class="page-header">
    <h1>Bài chia sẻ</h1>
    <p class="lead">Mỗi tuần 2 bài về cách dùng AI cho công việc hằng ngày.</p>
  </section>
  {tatCaBai.map((bai) => <BaiChiaSeCard bai={bai} />)}
</BaseLayout>
