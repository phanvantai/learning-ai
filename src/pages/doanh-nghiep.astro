---
import BusinessContactForm from '../components/BusinessContactForm.astro';
import { BUSINESS_CONTACT_FORM_ENDPOINT } from '../contact-form';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

interface CapDo {
  code: string;
  name: string;
  summary: string;
  duration: string;
  note?: string;
}

const CAP_DO: readonly CapDo[] = [
  {
    code: 'Lv0',
    name: 'AI là gì, sử dụng cơ bản',
    summary:
      'Hiểu AI làm được gì và không làm được gì, dùng an toàn, viết yêu cầu rõ ràng để nhận câu trả lời hữu ích ngay trong buổi.',
    duration: 'nửa ngày',
  },
  {
    code: 'Lv1',
    name: 'Tối ưu công việc cá nhân',
    summary:
      'Mỗi người mang việc thật của mình vào buổi: email, báo cáo, tổng hợp tài liệu, bảng tính… và ra về với cách làm nhanh hơn bằng AI.',
    duration: 'một ngày',
  },
  {
    code: 'Lv2',
    name: 'Đưa AI vào quy trình doanh nghiệp',
    summary:
      'Chọn một quy trình cụ thể của doanh nghiệp, cùng thiết kế lại với AI và tự động hóa những bước phù hợp.',
    duration: 'nhiều buổi, kèm tư vấn quy trình',
    note:
      'Lv2 chỉ mở sau khi mình đã tự đưa AI vào một quy trình doanh nghiệp thật ít nhất một lần. Hiện mình nhận thí điểm Lv0 và Lv1.',
  },
];
---

<BaseLayout
  title="Doanh nghiệp"
  description="Khóa đào tạo ứng dụng AI cho đội ngũ doanh nghiệp, chia theo 3 Cấp độ. Đang nhận doanh nghiệp thí điểm."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Đang nhận doanh nghiệp thí điểm</p>
      <h1>Khóa đào tạo AI cho đội ngũ của bạn</h1>
      <p class="lead">
        Giúp nhân sự không chuyên kỹ thuật dùng AI vào chính công việc hằng ngày của họ. Khóa đào tạo
        chia theo 3 Cấp độ, tổ chức trực tiếp tại doanh nghiệp hoặc online.
      </p>
      <div class="button-row">
        <a class="button" href="#lien-he-heading">Liên hệ thí điểm <Icon name="arrow-right" /></a>
        <a class="button button-secondary" href="#cap-do-heading">Xem 3 Cấp độ</a>
      </div>
    </div>
  </section>

  <div class="container page-body">
    <section aria-labelledby="cap-do-heading">
      <div class="section-head">
        <div>
          <h2 id="cap-do-heading">3 Cấp độ</h2>
          <p>Đi từ hiểu AI, tới dùng cho việc của từng người, rồi đưa vào quy trình chung.</p>
        </div>
      </div>
      <ol class="cap-do-list">
        {
          CAP_DO.map((capDo, i) => (
            <li class:list={['cap-do-card', `cap-do-${i}`, { 'cap-do-locked': capDo.note }]}>
              <p class="cap-do-ma">{capDo.code}</p>
              <h3>{capDo.name}</h3>
              <p>{capDo.summary}</p>
              <p class="cap-do-thoi-luong">
                <Icon name="clock" /> Thời lượng tham khảo: {capDo.duration}
              </p>
              {capDo.note && (
                <p class="cap-do-ghi-chu">
                  <Icon name="lock" /> <span>{capDo.note}</span>
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section contact-grid" aria-labelledby="lien-he-heading">
      <div class="contact-copy">
        <h2 id="thi-diem-heading">Giai đoạn thí điểm</h2>
        <p>
          Mình đang nhận một vài doanh nghiệp thí điểm đầu tiên cho Lv0 và Lv1. Nội dung được điều chỉnh
          theo công việc thật của đội ngũ bạn, và vì đang thí điểm nên mình chưa công bố bảng giá: chi phí
          trao đổi riêng theo quy mô và nhu cầu.
        </p>
        <ul class="checklist">
          <li><Icon name="check" /> Nội dung theo việc thật của đội ngũ</li>
          <li><Icon name="check" /> Trực tiếp hoặc online</li>
          <li><Icon name="check" /> Chi phí trao đổi theo quy mô</li>
        </ul>
      </div>
      <div class="card contact-card">
        <h2 id="lien-he-heading">Liên hệ thí điểm</h2>
        <p>
          Để lại vài thông tin về đội ngũ và nhu cầu của bạn, mình sẽ liên hệ lại để trao đổi cụ thể.
        </p>
        <BusinessContactForm endpoint={BUSINESS_CONTACT_FORM_ENDPOINT} />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .cap-do-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cap-do-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .cap-do-card .cap-do-ma {
    align-self: flex-start;
    margin: 0 0 1rem;
    padding: 0.2rem 0.75rem;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cap-do-1 .cap-do-ma {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .cap-do-2 .cap-do-ma {
    background: var(--ink);
    color: var(--ink-text);
  }

  .cap-do-card h3 {
    margin: 0 0 0.6rem;
    font-size: 1.2rem;
  }

  .cap-do-card p {
    margin: 0;
  }

  .cap-do-card > p:not([class]) {
    flex: 1;
    color: var(--muted);
    font-size: 0.975rem;
  }

  .cap-do-thoi-luong {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem !important;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.925rem;
    font-weight: 600;
  }

  .cap-do-thoi-luong :global(svg),
  .cap-do-ghi-chu :global(svg) {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: var(--accent);
  }

  .cap-do-locked {
    border-style: dashed;
    border-color: var(--border-strong);
    background: var(--bg-tint);
  }

  .cap-do-ghi-chu {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.85rem !important;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .cap-do-ghi-chu :global(svg) {
    margin-top: 0.2rem;
  }

  /* ---------- Thí điểm + form ---------- */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 2.5rem;
    align-items: start;
  }

  .contact-copy h2,
  .contact-card h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.5rem, 3.5vw, 2rem);
  }

  .contact-copy p,
  .contact-card > p {
    margin: 0 0 1.5rem;
    color: var(--muted);
  }

  .checklist {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checklist li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 500;
  }

  .checklist :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    padding: 0.25rem;
    border-radius: 50%;
    background: var(--teal-soft);
    color: var(--teal);
  }

  .contact-card {
    padding: clamp(1.5rem, 4vw, 2rem);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 56rem) {
    .cap-do-list,
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
