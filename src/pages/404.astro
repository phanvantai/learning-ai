---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Không tìm thấy trang">
  <section class="container container-narrow not-found">
    <p class="code" aria-hidden="true">404</p>
    <h1>Không tìm thấy trang</h1>
    <p class="lead">Trang bạn tìm không tồn tại hoặc đã được chuyển đi.</p>
    <div class="button-row">
      <a class="button" href="/"><Icon name="arrow-left" /> Về Trang chủ</a>
      <a class="button button-secondary" href="/bai-chia-se/">Đọc Bài chia sẻ</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-top: 5rem;
    text-align: center;
  }

  .code {
    margin: 0;
    background: linear-gradient(135deg, #fb923c, #c2410c);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-size: clamp(5rem, 18vw, 8rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .not-found h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .button-row {
    justify-content: center;
  }
</style>
