---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Không tìm thấy trang">
  <section class="page-head not-found">
    <div class="container">
      <p class="label" aria-hidden="true">Lỗi 404</p>
      <h1>Không tìm thấy trang</h1>
      <p class="lead">Trang bạn tìm không tồn tại hoặc đã được chuyển đi.</p>
      <div class="button-row">
        <a class="button" href="/"><Icon name="arrow-left" /> Về Trang chủ</a>
        <a class="button button-secondary" href="/bai-chia-se/">Đọc Bài chia sẻ</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding: 6rem 0;
  }
</style>
