---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChatContact from '../components/ChatContact.astro';
import Icon from '../components/Icon.astro';
import {
  BUOI,
  CHUA_HOP,
  HOP,
  HUONG,
  PHIEU_KHOI_DONG,
  TIEU_CHI_CHON_VIEC,
  TIEU_CHI_HOAN_THANH,
} from '../mentoring-program';
import { FOUNDER, MENTORING_BETA as BETA } from '../site';

/** Bài chia sẻ theo nghề, làm ví dụ cho loại việc có thể mang vào Mentoring. */
const VI_DU_DE_BAI = [
  { nghe: 'Kế toán', viec: 'Đối chiếu sao kê ngân hàng với sổ, ra danh sách dòng lệch.', huong: 'Tool', bai: 'ai-cho-ke-toan' },
  { nghe: 'Nhân sự', viec: 'Tóm tắt CV theo bộ tiêu chí của vị trí, người vẫn là người quyết định.', huong: 'Skill', bai: 'ai-cho-nhan-su' },
  { nghe: 'Marketing', viec: 'Một bài gốc thành các bản cho Facebook, email, kịch bản video, đúng giọng thương hiệu.', huong: 'Skill', bai: 'ai-cho-marketing-noi-dung' },
  { nghe: 'Bán hàng', viec: 'Ghi chú sau cuộc gọi thành cập nhật CRM và nháp email follow-up.', huong: 'Automation', bai: 'ai-cho-sales-cham-soc-khach-hang' },
  { nghe: 'Quản lý', viec: 'Ghi chú họp thành biên bản có việc, người phụ trách, hạn chót.', huong: 'Skill', bai: 'ai-cho-quan-ly-hop-va-du-an' },
];
---

<BaseLayout
  title="Mentoring"
  description={`Mentoring có lịch hẹn: ${BETA.sessions} buổi cùng bạn build một tool, automation hoặc skill AI chạy được cho công việc. Gói beta ${BETA.price}, giới hạn ${BETA.slots} suất.`}
>
  <section class="page-head">
    <div class="container head-grid">
      <div>
        <p class="label">Mentoring · làm việc riêng, có lịch hẹn</p>
        <h1>Một việc của bạn. Bốn buổi. Một <span class="mark">sản phẩm chạy được</span>.</h1>
        <p class="lead">
          Mentoring là các buổi làm việc riêng giữa bạn và mình, <strong>{FOUNDER.name}</strong>. Không
          giảng lý thuyết AI: hai bên chọn một việc lặp lại trong công việc của bạn rồi cùng build cho tới
          khi bạn có một tool, automation hoặc skill AI chạy được, và tự dùng, tự sửa được nó.
        </p>
        <div class="button-row">
          <a class="button" href="#lien-he">Nhắn để giữ suất <Icon name="arrow-right" /></a>
          <a class="button button-secondary" href="#chuong-trinh">Xem từng buổi</a>
        </div>
      </div>

      <section class="goi" aria-labelledby="goi-beta">
        <h2 id="goi-beta" class="label">Gói beta</h2>
        <p class="gia"><strong>{BETA.price}</strong> <span>/ gói</span></p>
        <dl class="facts">
          <div>
            <dt class="label">Thời lượng</dt>
            <dd>{BETA.sessions} buổi &times; {BETA.minutes} phút trong {BETA.period}</dd>
          </div>
          <div>
            <dt class="label">Hình thức</dt>
            <dd>Gọi online, chia sẻ màn hình</dd>
          </div>
          <div>
            <dt class="label">Kết quả</dt>
            <dd>Một tool, automation hoặc skill AI chạy được cho công việc của bạn</dd>
          </div>
          <div>
            <dt class="label">Số suất</dt>
            <dd>Giới hạn {BETA.slots} suất đầu tiên</dd>
          </div>
          <div>
            <dt class="label">Bắt đầu</dt>
            <dd>Bằng Tư vấn qua chat, chưa cần trả gì</dd>
          </div>
        </dl>
      </section>
    </div>
  </section>

  <div class="container">
    <section class="sheet sheet-first" aria-labelledby="nhan-duoc">
      <div class="sheet-label">
        <h2 id="nhan-duoc">Bạn mang về gì</h2>
        <p>Gói được coi là xong khi đủ cả bốn điều này.</p>
      </div>
      <div class="sheet-body">
        <ul class="ticks">
          {TIEU_CHI_HOAN_THANH.map((tieuChi) => <li>{tieuChi}</li>)}
        </ul>
        <p class="note">
          Hết {BETA.sessions} buổi mà chưa đạt, mình nói rõ còn thiếu gì. Mình không hứa trước con số tiết
          kiệm: số đo thật của bạn mới là thứ đáng tin.
        </p>
      </div>
    </section>

    <section class="sheet" aria-labelledby="huong">
      <div class="sheet-label">
        <h2 id="huong">Ba hướng</h2>
        <p>Chọn theo việc, không theo công cụ. Mặc định là hướng đơn giản nhất giải được việc.</p>
      </div>
      <div class="sheet-body table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Hướng</th>
              <th scope="col">Là gì</th>
              <th scope="col">Hợp khi</th>
              <th scope="col">Bạn cần</th>
            </tr>
          </thead>
          <tbody>
            {
              HUONG.map((huong) => (
                <tr>
                  <th scope="row">{huong.ten}</th>
                  <td>
                    {huong.laGi}
                    <span class="vi-du">Ví dụ: {huong.viDu}</span>
                  </td>
                  <td>{huong.hopKhi}</td>
                  <td>{huong.can}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="note">Chi phí tài khoản công cụ (nếu có) do bạn trả trực tiếp cho nhà cung cấp, không nằm trong giá gói.</p>
      </div>
    </section>

    <section class="sheet" id="chuong-trinh" aria-labelledby="chuong-trinh-heading">
      <div class="sheet-label">
        <h2 id="chuong-trinh-heading">Chương trình {BETA.sessions} buổi</h2>
        <p>
          Mỗi buổi {BETA.minutes} phút, kết thúc bằng một sản phẩm cụ thể và một bài tập dùng thật trước
          buổi sau.
        </p>
      </div>
      <ol class="sheet-body buoi-list">
        {
          BUOI.map((buoi) => (
            <li class="buoi">
              <p class="label">Buổi {buoi.so} · {buoi.tuan}</p>
              <h3>{buoi.ten}</h3>
              <p class="muc-tieu">{buoi.mucTieu}</p>
              <ol class="hoat-dong" aria-label={`Hoạt động buổi ${buoi.so}`}>
                {buoi.hoatDong.map((hoatDong) => (
                  <li>
                    <span class="phut">{hoatDong.phut}′</span>
                    <span>{hoatDong.noiDung}</span>
                  </li>
                ))}
              </ol>
              <dl class="ket-qua">
                <div>
                  <dt class="label">Sản phẩm</dt>
                  <dd>{buoi.sanPham}</dd>
                </div>
                {buoi.baiTap && (
                  <div>
                    <dt class="label">Bài tập</dt>
                    <dd>{buoi.baiTap}</dd>
                  </div>
                )}
              </dl>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sheet" aria-labelledby="giua-buoi">
      <div class="sheet-label">
        <h2 id="giua-buoi">Giữa các buổi</h2>
      </div>
      <div class="sheet-body">
        <ul class="ticks">
          <li>Kẹt ở đâu thì nhắn qua kênh chat, mình trả lời khi đọc được (không phải trực tuyến liên tục).</li>
          <li>Với hướng Tool: phần code chưa kịp trong buổi, mình hoàn thiện giữa hai buổi và giải thích lại ở đầu buổi sau.</li>
          <li>Bạn luôn giữ toàn bộ sản phẩm: hướng dẫn, luồng tự động, mã nguồn, tài liệu.</li>
        </ul>
      </div>
    </section>

    <section class="sheet" aria-labelledby="chon-viec">
      <div class="sheet-label">
        <h2 id="chon-viec">Chọn việc nào</h2>
        <p>Trước khi nhận, mình hỏi bạn sáu câu qua chat và soát việc đó theo bốn tiêu chí.</p>
      </div>
      <div class="sheet-body two-col">
        <div>
          <h3>Phiếu khởi động</h3>
          <ol class="rows numbered">
            {PHIEU_KHOI_DONG.map((cauHoi) => <li>{cauHoi}</li>)}
          </ol>
        </div>
        <div>
          <h3>Bốn tiêu chí</h3>
          <ul class="rows">
            {
              TIEU_CHI_CHON_VIEC.map((tieuChi) => (
                <li>
                  <strong>{tieuChi.ten}.</strong> {tieuChi.cauHoi}
                </li>
              ))
            }
          </ul>
          <p class="note">Thiếu một tiêu chí thì mình cùng bạn thu hẹp việc hoặc chọn việc khác.</p>
        </div>
      </div>
    </section>

    <section class="sheet" aria-labelledby="vi-du">
      <div class="sheet-label">
        <h2 id="vi-du">Ví dụ đề bài</h2>
        <p>Minh họa loại việc vừa với bốn buổi. Đây là ví dụ, chưa phải case study.</p>
      </div>
      <div class="sheet-body table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Nghiệp vụ</th>
              <th scope="col">Việc</th>
              <th scope="col">Hướng</th>
              <th scope="col">Đọc trước</th>
            </tr>
          </thead>
          <tbody>
            {
              VI_DU_DE_BAI.map((viDu) => (
                <tr>
                  <th scope="row">{viDu.nghe}</th>
                  <td>{viDu.viec}</td>
                  <td>{viDu.huong}</td>
                  <td><a href={`/bai-chia-se/${viDu.bai}/`}>Bài chia sẻ</a></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="sheet" aria-labelledby="hop">
      <div class="sheet-label">
        <h2 id="hop">Hợp và chưa hợp</h2>
      </div>
      <div class="sheet-body two-col">
        <div>
          <h3>Hợp khi</h3>
          <ul class="ticks">{HOP.map((dong) => <li>{dong}</li>)}</ul>
        </div>
        <div>
          <h3>Chưa hợp khi</h3>
          <ul class="ticks ticks-no">{CHUA_HOP.map((dong) => <li>{dong}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="sheet" aria-labelledby="quy-trinh">
      <div class="sheet-label">
        <h2 id="quy-trinh">Quy trình</h2>
      </div>
      <div class="sheet-body">
        <ol class="rows numbered">
          <li>
            <strong>Nhắn tin hỏi trước (Tư vấn qua chat, miễn phí).</strong> Kể mình nghe công việc của bạn
            và việc bạn muốn AI làm giúp. Mình trả lời và gợi ý hướng đi, không cần đặt lịch.
          </li>
          <li>
            <strong>Chuyển sang Mentoring khi cần.</strong> Khi việc cần gọi riêng, chia sẻ màn hình hoặc
            build hộ, mình đề xuất gói Mentoring và cùng bạn chốt mục tiêu.
          </li>
          <li>
            <strong>Cùng build.</strong> {BETA.sessions} buổi trong {BETA.period}, kết quả là một tool,
            automation hoặc skill AI chạy được cho công việc của bạn.
          </li>
        </ol>
        <p class="note">
          Tư vấn qua chat chính là bước thử: bạn xem cách mình trả lời có hợp với mình không rồi mới quyết
          định mua Mentoring.
        </p>
      </div>
    </section>

    <section class="sheet" aria-labelledby="dieu-khoan">
      <div class="sheet-label">
        <h2 id="dieu-khoan">Điều cần biết về gói beta</h2>
      </div>
      <dl class="sheet-body facts">
        <div>
          <dt class="label">Vì sao giá thấp</dt>
          <dd>
            Mình đang xây những case study đầu tiên. Đổi lại, học viên beta cam kết cho mình viết case study
            và để lại lời nhận xét về quá trình làm việc. Để mỗi người được làm kỹ, mình chỉ nhận tối đa 1–2
            học viên Mentoring cùng lúc.
          </dd>
        </div>
        <div>
          <dt class="label">Thanh toán</dt>
          <dd>Thanh toán bằng chuyển khoản. Website không thanh toán online.</dd>
        </div>
        <div>
          <dt class="label">Buổi lẻ</dt>
          <dd>
            Buổi lẻ chỉ bán thêm cho học viên đã mua gói, khi bạn muốn làm tiếp sau {BETA.sessions} buổi.
            Mentoring không có buổi thử riêng: Tư vấn qua chat là bước thử.
          </dd>
        </div>
      </dl>
    </section>

    <section class="sheet" aria-labelledby="case-study">
      <div class="sheet-label">
        <h2 id="case-study">Case study</h2>
      </div>
      <div class="sheet-body">
        <p class="empty-state">
          Chưa có case study nào. {BETA.slots} học viên beta đầu tiên sẽ là những case study đầu tiên ở đây,
          và bạn có thể là một trong số đó.
        </p>
      </div>
    </section>

    <ChatContact title="Bắt đầu bằng một tin nhắn">
      <p>
        Chọn kênh bạn quen dùng và kể mình nghe việc bạn muốn giải. Nếu việc của bạn cần Mentoring, mình sẽ
        nói rõ trước khi bạn trả tiền.
      </p>
    </ChatContact>
  </div>
</BaseLayout>

<style>
  .head-grid {
    display: grid;
    gap: 3rem;
  }

  .goi {
    align-self: end;
    padding: 1.5rem;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  .gia {
    margin: 0.4rem 0 1.1rem;
    font-family: var(--font-serif);
  }

  .gia strong {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .gia span {
    color: var(--muted);
  }

  .goi .facts > div {
    grid-template-columns: 6.5rem minmax(0, 1fr);
    font-size: 0.9375rem;
  }

  .goi .facts > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .vi-du {
    display: block;
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  h3 {
    font-size: 1.25rem;
  }

  .two-col {
    display: grid;
    gap: 2rem 3rem;
  }

  .two-col > div {
    margin: 0;
  }

  .two-col > div > * + * {
    margin-top: 0.9rem;
  }

  .numbered {
    counter-reset: so;
  }

  .numbered > li {
    position: relative;
    padding-left: 2.25rem;
    counter-increment: so;
  }

  .numbered > li::before {
    content: counter(so, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1rem;
    color: var(--blue);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  /* ---------- Từng buổi ---------- */
  .buoi-list {
    list-style: none;
  }

  .buoi {
    padding: 1.75rem 0;
    border-top: 1px solid var(--rule);
  }

  .buoi:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .buoi + .buoi {
    margin-top: 0;
  }

  .buoi h3 {
    margin: 0.3rem 0 0.4rem;
    font-size: 1.625rem;
  }

  .muc-tieu {
    color: var(--muted);
  }

  .hoat-dong {
    margin-top: 1.1rem;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .hoat-dong li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .phut {
    padding-top: 0.15rem;
    color: var(--blue);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .ket-qua {
    display: grid;
    gap: 0.75rem 2rem;
    margin: 1.1rem 0 0;
    padding: 1rem 1.1rem;
    background: var(--paper-2);
  }

  .ket-qua dd {
    margin: 0.2rem 0 0;
    font-size: 0.9375rem;
  }

  @media (min-width: 44rem) {
    .two-col,
    .ket-qua {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 62rem) {
    .head-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
